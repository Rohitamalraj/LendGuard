# ─── Solana ───────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PRIVATE_KEY=           # base58 keypair used for deploy + demos

# ─── LendGuard Program ────────────────────────────────────────────────────────
LENDGUARD_PROGRAM_ID=GQia1ewyLgtkgX7HSfuttJ42qNPpYJhUbxeyCPXtcJFR   # replace after anchor deploy

# ─── Ika dWallet (pre-alpha devnet) ───────────────────────────────────────────
# Docs: https://solana-pre-alpha.ika.xyz/
# Repo: https://github.com/dwallet-labs/ika-pre-alpha
IKA_GRPC_URL=https://pre-alpha-dev-1.ika.ika-network.net:443
IKA_PROGRAM_ID=87W54kGYFQ1rgWqMeu4XTPHWXWmXSQCcjm8vCTfiq1oY

# ─── Encrypt FHE (pre-alpha devnet) ───────────────────────────────────────────
# Docs: https://docs.encrypt.xyz/
# Repo: https://github.com/dwallet-labs/encrypt-pre-alpha
ENCRYPT_GRPC_URL=pre-alpha-dev-1.encrypt.ika-network.net:443
ENCRYPT_PROGRAM_ID=4ebfzWdKnrnGseuQpezXdG8yCdHqwQ1SSBHD3bWArND8

# ─── Demo Configuration ───────────────────────────────────────────────────────
DEMO_MODE=true
MOCK_BACKING_RATIO=95         # initial backing ratio (%)
EXPLOIT_BACKING_RATIO=85      # ratio after simulated exploit
EXPLOIT_SIMULATION_DELAY_MS=3000

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_LENDGUARD_PROGRAM_ID=GQia1ewyLgtkgX7HSfuttJ42qNPpYJhUbxeyCPXtcJFR
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_CLUSTER=devnet

# Live Encrypt pre-alpha executor — used by web/lib/encrypt-client.ts to call
# `createInput` from the browser via gRPC-Web.
NEXT_PUBLIC_ENCRYPT_GRPC_URL=https://pre-alpha-dev-1.encrypt.ika-network.net:443
NEXT_PUBLIC_ENCRYPT_PROGRAM=4ebfzWdKnrnGseuQpezXdG8yCdHqwQ1SSBHD3bWArND8

# ─── Bitcoin testnet collateral keepers ───────────────────────────────────────
# Used by contracts/scripts/btc-balance-keeper.mjs and
# contracts/scripts/btc-liquidation-broadcaster.mjs.
LENDGUARD_RPC=https://api.devnet.solana.com
LENDGUARD_AUTHORITY_KEYPAIR=/mnt/d/Projects/LendGuard/contracts/lendguard-devnet.json
